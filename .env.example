# ai-tools secrets — copy to `secrets.env` and fill in. NEVER commit secrets.env.
# The installer symlinks this into your shell profile so Claude Code sees these
# vars at launch and expands ${VAR} references in claude/mcp-servers.json.

# Homelab MCP — the FULL Authorization header value, "Bearer " prefix included:
# HOMELAB_MCP_TOKEN="Bearer <MCP_BEARER_TOKEN>". That token is the one Caddy checks
# in front of mcp-grafana and mcp-calendar (homelab-calendar uses it too), from docker/proxy/.env on the homelab (CT 100) — NOT a
# Grafana service-account token (glsa_...), which stays on the server.
HOMELAB_MCP_TOKEN=""

# HCP Terraform / Terraform Cloud API token (app.terraform.io → Account → Tokens).
# Forwarded into the terraform MCP container via `docker run -e TFE_TOKEN`.
TFE_TOKEN=""

# GitHub MCP — a fine-grained PAT (github.com → Settings → Developer settings →
# Fine-grained tokens): Contents, Issues, Pull requests, Actions = read & write.
# Bare token, no "Bearer " prefix. Sent as a header: GitHub's MCP OAuth has no
# dynamic client registration, so Claude Code can't log in to it on its own.
GITHUB_MCP_TOKEN=""

# Google Tasks MCP (google-tasks) — a Google Cloud OAuth client of type "Desktop app".
# Google Cloud console → project homelab-assistant → Google Auth Platform → Clients →
# "claude-code" (Google Tasks API enabled in that project). The secret is only shown
# when a client is created; if it's lost, add a new secret to that client.
GOOGLE_TASKS_CLIENT_ID=""
GOOGLE_TASKS_CLIENT_SECRET=""
